# vim: ft=sh
alias claude="claude --allow-dangerously-skip-permissions"
alias cla="claude"
alias clr="claude --resume"
alias fable="claude --model fable"
alias sonnet="claude --model sonnet"
alias agents="claude agents"
alias cdg='cd "$(git rev-parse --show-cdup)"'
alias cg='cd "$({ git rev-parse 2>/dev/null && fd --hidden --prune --max-depth=2 --format "{//}" "^\.git$" "$(git rev-parse --show-cdup).." || fd --hidden --prune --max-depth=3 --format "{//}" "^\.git$" } | fzf)"'
alias cr="cd -P"
alias g="git"
alias ifco="curl -qSs ifconfig.co/json | jq"
alias l="eza --long"
alias la="eza --long --all --git"
alias ll="eza --long --git"
alias lr="eza --long --git-repos"
alias ls="eza"
alias lt="eza --long --all --git --git-ignore --tree"
alias lg="lazygit"
alias lsb="lsblk -oNAME,TYPE,MAJ:MIN,RM,SUBSYSTEMS,MODEL,SIZE,RO,FSTYPE,FSSIZE,FSUSE%,FSUSED,FSAVAIL,MOUNTPOINT"
alias v="nvim"
alias ui="uv run --with ipython ipython"

# macOS app bundle CLI, only where the app is installed
[ -x /Applications/Tailscale.app/Contents/MacOS/Tailscale ] &&
  alias tailscale="/Applications/Tailscale.app/Contents/MacOS/Tailscale"

# fzf
alias fvg='vim "$(git ls-files -oc | fzf -0 --preview "bat --color=always --style=numbers {}")"'

# git worktrees
gwd() {
  local toplevel
  toplevel="$(git rev-parse --show-toplevel)" || return 1
  echo "$HOME/.worktrees/$(basename "$toplevel")"
}

gwa() {
  [ "$#" -ge 1 ] || {
    echo "usage: $0 BRANCH" >&2 && return 1
  }
  local dir="$(gwd)/$1"
  git worktree add "$dir" && cd "$dir"
}

gwl() {
  local list dir
  list="$(git worktree list)" || return 1
  dir="$(echo "$list" | fzf --height=40% | awk '{print $1}')"
  [ -n "$dir" ] && cd "$dir"
}

lazygit() {
  export XDG_CONFIG_HOME="$HOME/.config"
  command lazygit "$@"
}

fzg() {
  RG_PREFIX="rg --column --line-number --no-heading --color=always --smart-case --glob '!.git/**' --hidden "
  FZF_DEFAULT_COMMAND="$RG_PREFIX '$*'" \
    fzf --bind "change:reload:$RG_PREFIX {q} || true" \
    --ansi --phony --query "$*" --height=50% --layout=reverse
  unset RG_PREFIX
}

fzgf() {
  RG_PREFIX="rg --files-with-matches --color=always --smart-case --glob '!.git/**' --hidden "
  FZF_DEFAULT_COMMAND="$RG_PREFIX '$*'" \
    fzf --bind "change:reload:$RG_PREFIX {q} || true" \
    --ansi --phony --query "$*" --height=50% --layout=reverse \
    --preview "rg --column --line-number --no-heading --color=always --smart-case --glob '!.git/**' --hidden {q} {}"
  unset RG_PREFIX
}

20to5f() {
  [ "$#" -ge 1 ] || {
    echo "usage: $0 FILE..." >&2 && return 1
  }
  for f in "$@"; do
    mv -iv "$f" "${f// /_}"
  done
}

cpv() {
  [ "$#" -eq 2 ] || {
    echo "usage: $0 SRC DEST" >&2 && return 1
  }
  tar -c "$1" | pv -pterb -s "$(du -bs "$1" | cut -f1)" | tar -C "$2" -xp
}

exifdiff() {
  [ "$#" -eq 2 ] || {
    echo "usage: $0 OLD NEW" >&2 && return 2
  }
  diff <(exiftool "$1") <(exiftool "$2")
}
